{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "__MSG_shortName__",
  "version": "0.3.1",
  "description": "__MSG_description__",
  "default_locale": "en",
  "homepage_url": "https://andronaft.github.io/FileForge/",
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "__MSG_commandOpen__"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "scripting"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
  },
  "sandbox": {
    "pages": [
      "app/heic-sandbox.html"
    ]
  }
}
