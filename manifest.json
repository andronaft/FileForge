{
  "manifest_version": 3,
  "name": "FileForge",
  "version": "0.2.0",
  "description": "Crop, resize, compress and convert images (incl. HEIC), merge/split/compress PDFs, Markdown to PDF, CSV/JSON tools. 100% on your device, nothing is uploaded.",
  "action": {
    "default_title": "Open FileForge"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "sandbox": {
    "pages": [
      "app/heic-sandbox.html"
    ]
  },
  "homepage_url": "https://github.com/andronaft/FileForge"
}
